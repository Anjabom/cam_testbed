# 머신마다 다른 것들. `local.yaml` 로 복사해서 쓴다(버전관리 제외).
# 시나리오/계약 위에 덮어써진다 → 시나리오 파일은 머신 독립으로 유지된다.

# 계약이 여러 개일 때 기본으로 쓸 것 (시나리오의 contract: 가 우선)
default_contract: contracts/white_camera.yaml

# ── 영상 카탈로그 ──────────────────────────────────────────────────
#   시나리오에는 ★논리 이름★만 적고 실제 경로는 여기 둔다.
#   영상은 머신마다·대회마다 다르므로 시나리오에 절대경로를 박으면 안 된다.
videos:
  track_a: /home/anjabom/track_record.mp4      # 2026 다른 대회 트랙 (실내 모형)
  track_b: /home/anjabom/track1.mp4            # 같은 대회, 다른 랩
  webcam:  /home/anjabom/webcam_20260720_155948.mp4

# 모든 시나리오를 무시하고 이 영상으로 (비상 스위치, 보통은 주석)
# video: /path/to/one_off.mp4

# ── 가중치 ─────────────────────────────────────────────────────────
#   ★.pt 로 내리지 않는다★ 실차가 TensorRT .engine 으로 돈다. .pt(FP32) 로 재면
#   지연도 마스크 두께도, 그래서 conf·s_ref 도 실차와 다른 것을 재게 되는데
#   리포트는 그대로 초록으로 나온다 — 로그를 뒤져야만 드러나는 거짓말이라
#   계약의 require_params 가 실행 ★전★ 에 막는다(확장자·파일 존재 둘 다).
#   ★이 노트북이 곧 실차다★ 그래서 여기 적힌 경로가 실차 경로 그대로다.
#   다른 기계로 옮겨 .engine 이 안 열리면(빌드한 GPU/TRT 버전에 묶인다)
#   그 기계에서 .engine 을 다시 빌드한다 — .pt 로 되돌리는 건 재는 대상을
#   바꾸는 것이라 답이 아니다.
params:
  # ── white1 / traffic_light (정지선·신호등) ──────────────────────────
  traffic_light:
    tl_weights: /home/mad2/runs2/runs/detect/combined_light/weights/best.engine
    sl_weights: /home/mad2/runs2/runs/segment/lane_line_new2/weights/best.engine
    device: cuda:0

  # ── white / perception (차선) ───────────────────────────────────────
  perception:
    lane_weights_roi: /home/mad2/runs2/runs/segment/lane_line_new2/weights/best.engine
    tl_weights_roi:   /home/mad2/runs2/runs/detect/combined_light/weights/best.engine
    device: cuda

env:
  YOLO_VERBOSE: "false"
