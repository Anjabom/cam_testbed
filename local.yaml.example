# 머신마다 다른 것들. `local.yaml` 로 복사해서 쓴다(버전관리 제외).
# 시나리오/계약 위에 덮어써진다 → 시나리오 파일은 머신 독립으로 유지된다.

# 계약이 여러 개일 때 기본으로 쓸 것 (시나리오의 contract: 가 우선)
default_contract: contracts/white_camera.yaml

# ── 영상 카탈로그 ──────────────────────────────────────────────────
#   시나리오에는 ★논리 이름★만 적고 실제 경로는 여기 둔다.
#   영상은 머신마다·대회마다 다르므로 시나리오에 절대경로를 박으면 안 된다.
videos:
  track_a: /home/anjabom/track_record.mp4      # 2026 다른 대회 트랙 (실내 모형)
  track_b: /home/anjabom/track1.mp4            # 같은 대회, 다른 랩
  webcam:  /home/anjabom/webcam_20260720_155948.mp4

# 모든 시나리오를 무시하고 이 영상으로 (비상 스위치, 보통은 주석)
# video: /path/to/one_off.mp4

params:
  # ── white1 / traffic_light (정지선·신호등) ──────────────────────────
  #   실차 기본값은 /home/mad2/... 의 ★.engine★ 이다. .engine 은 빌드한 GPU 에
  #   묶여 있어 다른 기계에서는 안 열린다 — 같은 학습 결과의 .pt 를 쓴다.
  traffic_light:
    tl_weights: /home/<사용자>/runs2/runs/detect/combined_light/weights/best.pt
    sl_weights: /home/<사용자>/runs2/runs/segment/lane_line_new2/weights/best.pt
    device: cuda:0

  perception:
    # 실차는 TensorRT .engine 을 쓰지만 GPU/TRT 버전이 다르면 안 열린다.
    # 데스크톱에서는 같은 학습 결과의 .pt 를 쓴다.
    lane_weights_roi: /home/anjabom/runs2/runs/segment/lane_line_new2/weights/best.pt
    tl_weights_roi:   /home/anjabom/runs2/runs/detect/combined_light/weights/best.pt
    device: cuda

env:
  YOLO_VERBOSE: "false"
