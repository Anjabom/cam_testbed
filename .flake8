# flake8 설정 — 테스트베드 자신의 것.
#
# 예전에는 이 폴더가 white_cam_ws 안에 있어서 그쪽 .flake8 을 물려받았다.
# 이제 별도 디렉터리이므로 자기 설정을 들고 다닌다(그래야 어디로 옮겨도 같다).
#
# 끄는 것은 '스타일 취향'뿐이고, 버그를 잡는 F-계열(미정의 이름·미사용 import·
# 중복 정의)은 그대로 살려 둔다.

[flake8]
max-line-length = 100

extend-ignore =
    # 이어지는 줄 들여쓰기 — 인자를 세로로 맞춰 읽는 곳이 많다
    E126, E127, E128, E131,
    # 가드 구문 한 줄 압축 — `cap.release(); return None` 같은 정리 코드
    E701, E702,
    # 줄바꿈 위치 취향 (pycodestyle 기본 무시 항목)
    W503, W504

exclude =
    __pycache__,
    runs,
    .git
