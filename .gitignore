# ★앞의 / 가 중요하다★ — `runs/` 로 두면 어느 깊이의 runs 든 걸려서
# 내보낸 사이트의 docs/api/runs/ 까지 통째로 빠진다(껍데기만 배포된다).
/runs/
local.yaml
__pycache__/
*.pyc
web/__pycache__/

# 스크래치 로그 (실수로 들어가지 않게)
*.log

# 콜콘 산출물 — COLCON_IGNORE 가 있어도 손으로 돌리면 생긴다
/build/
/install/
/log/

# 손으로 뜬 백업 — 기계에 묶인 경로·캘리브 값이 들어 있다
*.bak-*

# 스튜디오로 불러오는 ★내 캘리브 값★ — 이 차의 기하라서 올리지 않는다
my_tuning.json
